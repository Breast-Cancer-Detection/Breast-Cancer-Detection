# Comma-separated frontend origins allowed to call this API.
# localhost:5173 is always permitted, so this is only needed for deployments.
ALLOWED_ORIGINS=https://your-app.vercel.app

# Public base URL of the folder holding the four .pt checkpoints.
# Required on hosts that cannot read Git LFS, such as Railway.
CHECKPOINT_BASE_URL=https://your-project.supabase.co/storage/v1/object/public/checkpoints

# Where checkpoints are read from and cached. Point this at a mounted volume
# so the weights survive restarts instead of downloading again.
CHECKPOINT_DIR=/data/checkpoints
